{
    "compilerOptions":{
        "target": "esnext",
        "module": "commonjs", 
        "lib":["ESNext"],
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "rootDir":"src",
        "outDir":"dist",
    }, 
    "include":["src/**/*.ts"], 
    "exclude":["node_modules", "dist", "migraton"]
}